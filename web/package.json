{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "pnpm prisma:generate && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm test && pnpm lint && pnpm build",
    "prisma:migration:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script -o prisma/migration.sql",
    "prisma:migration:apply": "tsx prisma/apply-migration.ts",
    "prisma:migration:deploy": "pnpm prisma:migration:sql && pnpm prisma:migration:apply",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.1",
    "@prisma/client": "^7.4.0",
    "bcryptjs": "^3.0.3",
    "mammoth": "^1.11.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "pdf-parse": "^2.4.5",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "pnpm prisma:seed"
  }
}
