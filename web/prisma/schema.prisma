generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionPolicy {
  BlockNew
  KickOld
}

enum SessionStatus {
  active
  revoked
  expired
  submitted
}

enum SubmissionMode {
  manual
  timeout
}

enum StrikeAction {
  NONE
  WARNING
  TEMPORARY_LOCK
  AUTO_SUBMIT
}

// --- NextAuth models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  exams         Exam[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model Exam {
  id            String       @id @default(cuid())
  accessCode    String       @unique
  title         String
  duration      Int          @default(60)
  startsAt      DateTime
  endsAt        DateTime
  sessionPolicy SessionPolicy @default(BlockNew)
  warningThreshold Int       @default(3)
  temporaryLockThreshold Int @default(5)
  autoSubmitThreshold Int    @default(8)
  lecturerId    String
  lecturer      User         @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  candidates    Candidate[]
  sessions      ExamSession[]
  questions     Question[]
  submissions   Submission[]
  eventLogs     EventLog[]
  strikeStates  StrikeState[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Candidate {
  id                String       @id @default(cuid())
  examId            String
  candidateId       String
  surnameNormalized String
  displayName       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  exam              Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sessions          ExamSession[]
  submissions       Submission[]

  @@unique([examId, candidateId])
  @@index([examId, surnameNormalized])
}

model ExamSession {
  id                String       @id @default(cuid())
  examId            String
  candidateRecordId String
  tokenHash         String       @unique
  status            SessionStatus @default(active)
  expiresAt         DateTime
  extendedUntil     DateTime?
  createdAt         DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  revokedAt         DateTime?
  submittedAt       DateTime?
  clientIp          String
  userAgent         String
  exam              Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate         Candidate    @relation(fields: [candidateRecordId], references: [id], onDelete: Cascade)
  sessionQuestions  SessionQuestion[]
  answers           Answer[]
  submission        Submission?
  eventLogs         EventLog[]
  strikeState       StrikeState?

  @@index([examId, candidateRecordId, status])
  @@index([status, expiresAt])
}

model Question {
  id            String            @id @default(cuid())
  examId        String
  prompt        String
  options       Json
  correctOption String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  exam          Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  sessionLinks  SessionQuestion[]
  answers       Answer[]

  @@index([examId])
}

model SessionQuestion {
  id         String     @id @default(cuid())
  sessionId  String
  questionId String
  orderIndex Int
  createdAt  DateTime   @default(now())
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@unique([sessionId, orderIndex])
  @@index([questionId])
}

model Answer {
  id             String      @id @default(cuid())
  sessionId      String
  questionId     String
  selectedOption String
  savedAt        DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  session        ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId, savedAt])
}

model Submission {
  id                String         @id @default(cuid())
  sessionId         String         @unique
  examId            String
  candidateRecordId String
  receiptId         String         @unique
  mode              SubmissionMode
  totalQuestions    Int
  answeredQuestions Int
  correctAnswers    Int
  scorePercent      Float
  submittedAt       DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  session           ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exam              Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  candidate         Candidate      @relation(fields: [candidateRecordId], references: [id], onDelete: Cascade)

  @@index([examId, candidateRecordId])
}

model EventLog {
  id                String      @id @default(cuid())
  sessionId         String
  examId            String
  candidateRecordId String
  eventType         String
  metadata          Json?
  addedStrikes      Int         @default(0)
  totalStrikesAfter Int
  createdAt         DateTime    @default(now())
  session           ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exam              Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, createdAt])
  @@index([sessionId, createdAt])
}

model StrikeState {
  id                String       @id @default(cuid())
  sessionId         String       @unique
  examId            String
  candidateRecordId String
  totalStrikes      Int          @default(0)
  lastAction        StrikeAction @default(NONE)
  isDisconnected    Boolean      @default(false)
  lastEventType     String?
  lastEventAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  session           ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exam              Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, totalStrikes])
  @@index([examId, updatedAt])
}
